# Copy to .env.local (or run `npm run setup`, which does it for you).
# Everything except BETTER_AUTH_SECRET is optional: without a key, that
# feature runs in demo mode so the whole app still works.

# --- Auth (required) ---
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional): https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database ---
# Local SQLite file by default. For production use Turso's free tier:
# DATABASE_URL=libsql://your-db.turso.io  and  DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# --- AI providers (free tiers) ---
# Gemini: https://aistudio.google.com/apikey  (code gen + shorts scripts)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Cloudflare Workers AI: https://dash.cloudflare.com  (image gen, 10k Neurons/day free)
# Token needs the "Workers AI" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Video renderer is simulated. Share of jobs that fail on purpose to show refunds:
MOCK_FAILURE_RATE=0.1
# MOCK_VIDEO_URL=https://.../sample.mp4

# --- Payments: Razorpay test mode (free) ---
# https://dashboard.razorpay.com/app/website-app-settings/api-keys (switch to Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: https://<your-domain>/api/billing/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
# Allow the demo checkout in production builds (never for a real launch):
ALLOW_MOCK_PAYMENTS=false
